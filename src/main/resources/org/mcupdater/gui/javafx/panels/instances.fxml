<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import org.mcupdater.gui.javafx.components.ProfilePane?>
<BorderPane fx:controller="org.mcupdater.gui.javafx.panels.Instances"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml" >
    <top>
        <AnchorPane>
            <ListView fx:id="listInstances" fixedCellSize="128.0" nodeOrientation="LEFT_TO_RIGHT" orientation="HORIZONTAL" prefHeight="144.0" prefWidth="128.0" style="-fx-background-image: url(/org/mcupdater/gui/javafx/img/bg_main2.png);" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" />
            <!--
            <VBox AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">
                <Button fx:id="btnAddURL" onAction="#addInstance"/>
                <Button fx:id="btnReload" onAction="#doRefresh"/>
            </VBox>
            -->
        </AnchorPane>
    </top>
    <center>
        <TabPane fx:id="tabpaneDetail" tabClosingPolicy="UNAVAILABLE"/>
    </center>
    <bottom>
        <GridPane hgap="3" minHeight="40" prefHeight="40" style="-fx-background-image: url(/org/mcupdater/gui/javafx/img/bg_main2.png);">
            <Label fx:id="lblStatus" GridPane.columnIndex="0" GridPane.halignment="LEFT" GridPane.rowIndex="0" style="-fx-text-fill: white"/>
            <ProfilePane fx:id="profiles" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label fx:id="lblHard" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-text-fill: white"/>
            <CheckBox fx:id="chkHard" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
            <Button fx:id="btnUpdate" onAction="#doUpdate" GridPane.columnIndex="4" GridPane.rowIndex="0"/>
            <Button fx:id="btnLaunch" onAction="#doLaunch" GridPane.columnIndex="5" GridPane.rowIndex="0"/>
            <rowConstraints>
                <RowConstraints fillHeight="true" vgrow="ALWAYS"/>
            </rowConstraints>
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS"/>
                <ColumnConstraints hgrow="SOMETIMES"/>
                <ColumnConstraints hgrow="NEVER"/>
                <ColumnConstraints hgrow="NEVER"/>
                <ColumnConstraints/>
                <ColumnConstraints/>
            </columnConstraints>
            <padding>
                <Insets bottom="5" left="5" right="5" top="5"/>
            </padding>
        </GridPane>
    </bottom>
</BorderPane>
